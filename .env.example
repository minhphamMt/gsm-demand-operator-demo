# P-042 root tooling environment template.
# Runtime services use apps/backend/.env and apps/frontend/.env as documented in README.md.
# Never commit populated .env files.

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
MODEL_VERSION=unset

# AI usage logging hooks. Obtain the ingest key from the course owner.
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=replace-with-ai-log-ingest-key
AI_LOG_DIR=.ai-log
