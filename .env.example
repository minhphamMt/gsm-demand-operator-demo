# P-042 local environment template
# Copy to .env for root-level tooling. Docker Compose uses the service-specific
# backEnd/.env and frontEnd/.env files described in README.md.
# Never commit populated .env files.

# Optional legacy root Python scaffold
OPENAI_API_KEY=replace-with-openai-api-key
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
CHROMA_PERSIST_DIR=./data/chroma
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LANGCHAIN_API_KEY=replace-with-langsmith-api-key
LANGCHAIN_PROJECT=p-042
LANGCHAIN_TRACING_V2=false
LOG_LEVEL=INFO

# AI usage logging hooks. Obtain an ingest key from the course owner; do not
# paste a shared or personal key into this tracked example.
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=replace-with-ai-log-ingest-key
AI_LOG_DIR=.ai-log
