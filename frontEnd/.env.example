# Public browser token from https://console.mapbox.com/account/access-tokens/
VITE_MAPBOX_ACCESS_TOKEN=pk.your-public-mapbox-token
# Default to the real backend. Switch explicitly to `mock` only for isolated UI work.
VITE_DATA_SOURCE=api
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
VITE_DEMO_MODE=false
