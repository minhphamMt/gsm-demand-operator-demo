# ============================================
# GSM-14 NovaFour — biến môi trường
# ============================================
# Copy sang .env rồi chỉnh. KHÔNG commit .env (đã có trong .gitignore).
#
# Ở đây chỉ có tham số hạ tầng. Mọi NGƯỠNG NGHIỆP VỤ (min_supply_per_zone,
# budget_cap, incentive_*, activation_radius_km, ...) nằm ở config/policy.yaml —
# đặt ngưỡng vào biến môi trường là tạo nguồn sự thật thứ hai (CLAUDE.md §3 #2).

# ---- App ----
APP_ENV=development          # development | production | test
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ---- Truy vết ----
# Phải khớp model_manifest.json khi chạy bundle model đã huấn luyện.
MODEL_VERSION=lgbm_quantile_v1

# ---- Đường dẫn (bỏ trống để dùng mặc định trong src/config.py) ----
# POLICY_PATH=config/policy.yaml
# ZONE_REGISTRY_PATH=config/zone_registry.json
# DRIVER_REGISTRY_PATH=config/driver_registry.json
# HISTORY_DB_PATH=data/history.db

# ---- Điều phối multi-agent ----
# false = mỗi agent chạy chuỗi tool cố định, cùng snapshot cho cùng kết quả. Đây là chế độ
# bắt buộc khi chạy eval và CI, vì baseline đã khóa và INV-1/2/3 so theo sai số 1e-6.
# true = agent tự chọn tool bằng LLM; chỉ dùng cho demo.
LLM_ROUTING_ENABLED=false

# Gateway OpenAI-compatible (mặc định OpenRouter). Đổi nhà cung cấp chỉ cần đổi hai dòng này.
LLM_BASE_URL=https://openrouter.ai/api/v1
# Khóa để TRỐNG ở đây. Giá trị thật chỉ đặt trong .env đã Git-ignored (CLAUDE.md §8 #1).
LLM_API_KEY=

# Slug phải khớp danh sách model của gateway (openrouter.ai/models). Đặt cả hai thành
# openrouter/free để chạy $0 khi phát triển — router đó tự lọc model có hỗ trợ tool calling.
LLM_MODEL_ANALYSIS=google/gemini-3.7-flash
LLM_MODEL_EXPLANATION=anthropic/claude-haiku-4.5

LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOOL_ROUNDS=6

# langgraph kéo theo langsmith (telemetry của LangChain). Tắt tường minh: repo cấm gọi API
# ra ngoài ngoài luồng đã duyệt (CLAUDE.md §8 #2), và snapshot vận hành không được rời máy.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false

# ---- AI usage logging (deliverable #4) ----
# Nhận khóa ingest từ chủ khóa học và chỉ đặt trong file .env Git-ignored.
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=replace-with-ai-log-ingest-key
AI_LOG_DIR=.ai-log
