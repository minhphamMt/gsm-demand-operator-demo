{
  "name": "gsm-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "backup:critical": "node --env-file=.env scripts/backup-critical-data.mjs",
    "backup:verify": "node scripts/verify-critical-backup.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "check:live": "npm run check && npm run smoke:db && npm run smoke:api && npm run smoke:campaign && npm run smoke:security",
    "clean:ai-readiness": "node --env-file=.env scripts/clean-ai-readiness-data.mjs",
    "prepare:test-db": "node --env-file=.env --env-file=.env.test.local scripts/prepare-full-test-db.mjs",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "smoke:db": "node --env-file=.env scripts/db-smoke.mjs",
    "setup:test-users": "node --env-file=.env --env-file=.env.test.local scripts/setup-test-users.mjs",
    "seed:review-proposals": "node --env-file=.env scripts/seed-review-proposals.mjs",
    "smoke:api": "node --env-file=.env --env-file=.env.test.local scripts/api-smoke.mjs",
    "smoke:campaign": "node --env-file=.env --env-file=.env.test.local scripts/campaign-flow-smoke.mjs",
    "smoke:model-flow": "node --env-file=.env --env-file=.env.test.local scripts/model-operator-flow-smoke.mjs",
    "smoke:security": "node --env-file=.env --env-file=.env.test.local scripts/security-concurrency-smoke.mjs",
    "simulate:planning": "node --env-file=.env scripts/simulate-planning.mjs",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.5.0",
    "@supabase/supabase-js": "^2.57.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "@types/supertest": "^6.0.3",
    "jest": "^30.1.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "js-yaml": "5.2.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
